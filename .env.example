# Copier en .env et compléter. Seule AWS_REGION est obligatoire, le reste a une valeur par défaut.

PORT=3000
AWS_REGION=eu-central-1

# Stockage des comptes et conversations (fichier JSON, créé automatiquement)
DATA_FILE=data/db.json

# Sessions et connexion
SESSION_TTL_DAYS=7
LOGIN_ATTEMPTS_PER_MINUTE=5

# Modèle Bedrock et paramètres de génération
MODEL_ID=zai.glm-4.7-flash
MODEL_LABEL=GLM-4.7 Flash
MAX_TOKENS=2048
TEMPERATURE=0.5
# SYSTEM_PROMPT="Tu es l'assistant interne de l'entreprise..."

# Appels Bedrock : timeout (ms) et nombre total de tentatives (1 appel + retries)
BEDROCK_TIMEOUT_MS=60000
BEDROCK_MAX_ATTEMPTS=2

# Limites
MAX_BODY_SIZE=15mb
MAX_MESSAGE_LENGTH=8000
MAX_HISTORY_MESSAGE_LENGTH=20000
MAX_HISTORY_MESSAGES=20
MAX_DOCUMENT_CHARS=60000
